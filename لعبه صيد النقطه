<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>صيد النقطة</title>
<style>
body{margin:0;background:#0a1931;color:white;font-family:Arial;text-align:center}
.box{display:flex;justify-content:center;gap:10px;margin:15px}
.card{background:#162a50;border:1px solid #2a4b8d;border-radius:15px;padding:10px;width:80px}
.card b{font-size:28px;display:block}
#game{width:90%;max-width:400px;height:450px;background:#11244d;border:2px solid #2a4b8d;border-radius:20px;margin:20px auto;position:relative;overflow:hidden;touch-action:none}
#dot{width:50px;height:50px;background:red;border-radius:50%;position:absolute;display:none;cursor:pointer;box-shadow:0 0 15px red}
#startBtn{padding:15px 50px;font-size:22px;border:none;border-radius:30px;background:white;color:#0a1931;font-weight:bold;margin-top:180px}
</style>
</head>
<body>
<h3>صيد النقطة</h3>
<p>اضغط على النقطة الحمرا معاك 20 ثانية</p>
<div class="box">
<div class="card"><b id="score">0</b>نقاطك</div>
<div class="card"><b id="time">20</b>ثانية</div>
<div class="card"><b id="best">0</b>أعلى نتيجة</div>
</div>
<div id="game">
<button id="startBtn">ابدأ</button>
<div id="dot"></div>
</div>
<script>
let score=0,time=20,timer,game=document.getElementById('game'),dot=document.getElementById('dot'),scoreEl=document.getElementById('score'),timeEl=document.getElementById('time'),bestEl=document.getElementById('best'),startBtn=document.getElementById('startBtn');
bestEl.textContent=localStorage.getItem('best')||0;
function moveDot(){
let x=Math.random()*(game.clientWidth-50);
let y=Math.random()*(game.clientHeight-50);
dot.style.left=x+'px'; dot.style.top=y+'px'; dot.style.display='block';
}
function startGame(){
score=0; time=20; scoreEl.textContent=0; timeEl.textContent=20;
startBtn.style.display='none'; moveDot();
timer=setInterval(()=>{time--; timeEl.textContent=time; if(time<=0) endGame();},1000);
}
function endGame(){
clearInterval(timer); dot.style.display='none'; startBtn.style.display='block'; startBtn.textContent='العب تاني';
if(score>bestEl.textContent){localStorage.setItem('best',score); bestEl.textContent=score;}
}
dot.addEventListener('touchstart',hit); dot.addEventListener('click',hit);
function hit(e){e.preventDefault(); score++; scoreEl.textContent=score; moveDot();}
startBtn.addEventListener('touchstart',(e)=>{e.preventDefault(); startGame();});
startBtn.addEventListener('click',startGame);
</script>
</body>
</html>
